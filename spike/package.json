{
  "name": "contextprune-spike",
  "displayName": "ContextPrune Spike",
  "description": "Phase 0 API de-risking spike. Throwaway — not the real extension.",
  "version": "0.0.1",
  "private": true,
  "publisher": "contextprune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gauravdotanand-a11y/ContextPrune.git",
    "directory": "spike"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextprune",
          "title": "ContextPrune",
          "icon": "images/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "contextprune": [
        {
          "id": "contextprune.spike.sidebar",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "contextprune.spike.runDiagnostics",
        "title": "ContextPrune Spike: Run API Diagnostics"
      },
      {
        "command": "contextprune.spike.runBenchmark",
        "title": "ContextPrune Spike: Run Token-Savings Benchmark"
      },
      {
        "command": "contextprune.spike.openDashboard",
        "title": "ContextPrune Spike: Open Dashboard"
      },
      {
        "command": "contextprune.spike.signInWithGithub",
        "title": "ContextPrune Spike: Sign in with GitHub"
      },
      {
        "command": "contextprune.spike.applyTerseInstructions",
        "title": "ContextPrune Spike: Apply Terse-Output Instructions"
      },
      {
        "command": "contextprune.spike.addLeanMode",
        "title": "ContextPrune Spike: Add \"ContextPrune Lean\" Custom Mode"
      },
      {
        "command": "contextprune.spike.reviewOpenTabs",
        "title": "ContextPrune Spike: Review Open Tabs"
      }
    ],
    "configuration": {
      "title": "ContextPrune",
      "properties": {
        "contextprune.leanMode.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "markdownDescription": "Model family id pinned in the generated `.github/agents/contextprune-lean.agent.md` file. Must be one of the family ids your org's own `Run API Diagnostics` returned — every org's model list differs. Regenerate the file (`ContextPrune Spike: Add \"ContextPrune Lean\" Custom Mode`) after changing this."
        },
        "contextprune.maxOpenTabs": {
          "type": "number",
          "default": 5,
          "description": "Advisory only, shown in 'Review Open Tabs' — the number of open text tabs above which Copilot's 'neighboring tabs' inline-completion context starts getting noisy."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "contextprune.spike",
        "name": "contextprune-spike",
        "fullName": "ContextPrune Spike",
        "description": "Counts tokens for your prompt to verify the LM + Chat APIs.",
        "isSticky": false,
        "commands": [
          {
            "name": "callmodel",
            "description": "Also send a minimal request to the model (consumes Copilot quota)"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies -o contextprune-spike.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.5.4"
  }
}
